# Copy to .env for local (non-Compose) runs.
# Compose injects DATABASE_URL for the app service; you usually do not need a local .env.
# pytest and the eval harness use in-memory SQLite unless TEST_DATABASE_URL is set.

DATABASE_URL=postgresql+asyncpg://vendor:vendor@localhost:5432/vendor_orchestrator

# Optional: run tests against Compose Postgres instead of SQLite.
# TEST_DATABASE_URL=postgresql+asyncpg://vendor:vendor@localhost:5432/vendor_orchestrator

# Leave unset to call the in-process mock vendor via ASGI (default, no sidecar).
# Set only if you later run a separate mock HTTP process.
# MOCK_VENDOR_ALPHA_URL=http://localhost:8000/mock/vendors
# MOCK_VENDOR_BETA_URL=http://localhost:8000/mock/vendors
